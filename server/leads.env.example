# Keep actual credentials in /etc/needle-shark/leads.env (root:root 0600).
CRM_DSN="dbname=needle_shark user=needle_app host=127.0.0.1 password=REPLACE"
IP_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MAIL_RECIPIENTS=REPLACE_WITH_APPROVED_RECIPIENT
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Empty SMTP credentials pause delivery, but do not interrupt saving leads.
